// skyforge-urltidy

функция совпадает_в_позиции(строка, подстрока, позиция) {
    если позиция + длина(подстрока) > длина(строка) { вернуть ложь }
    для i от 0 до (длина(подстрока) - 1) {
        если строка[позиция + i] != подстрока[i] {
            вернуть ложь
        }
    }
    вернуть истина
}

функция начинается_с(строка, префикс) {
    вернуть совпадает_в_позиции(строка, префикс, 0)
}

функция укоротить(ссылка) {
    пусть префикс = "https://github.com/"
    пусть короткий = "gh:"
    
    если не начинается_с(ссылка, префикс) {
        вернуть ссылка
    }
    
    пусть остаток = подстрока(ссылка, длина(префикс), длина(ссылка))
    пусть маркер = "/releases/download/"
    
    для i от 0 до (длина(остаток) - длина(маркер)) {
        если совпадает_в_позиции(остаток, маркер, i) {
            пусть до = подстрока(остаток, 0, i)
            пусть после = подстрока(остаток, i + длина(маркер), длина(остаток))
            вернуть короткий + до + "@" + после
        }
    }
    
    вернуть короткий + остаток
}

функция расширить(короткая) {
    пусть префикс = "gh:"
    если не начинается_с(короткая, префикс) {
        вернуть короткая
    }
    
    пусть остаток = подстрока(короткая, длина(префикс), длина(короткая))
    
    для i от 0 до (длина(остаток) - 1) {
        если остаток[i] == "@" {
            пусть до = подстрока(остаток, 0, i)
            пусть после = подстрока(остаток, i + 1, длина(остаток))
            вернуть "https://github.com/" + до + "/releases/download/" + после
        }
    }
    
    вернуть короткая
}
